---
import "../styles/animations.css";
import "../styles/scrollbar.css";
import "../styles/transitions.css";
import "../styles/searchbar.css";
import "overlayscrollbars/overlayscrollbars.css";
---

<style is:global>
  a {
    /* color: var(--text-color); */
    color: var(--text-color);
    background: var(--background-color);
    text-decoration: none;
    transition: color 0.2s, background 0.2s;
  }
  a:visited, a:active {
    color: var(--text-color);
  }
  a:hover, a:focus {
    color: var(--primary-color-hover);
    background: var(--background-color);
  }

  :root {
    --primary-color: oklch(15% 0 0); /* dark grey */
    --primary-color-lighten: oklch(30% 0 0); /* lighter dark grey */
    --primary-color-hover: oklch(60% 0.21 29); /* vivid red for hover */
    --primary-color-transparent: oklch(15% 0 0 / 15%);
    --text-color: oklch(95% 0 0); /* white */
    --text-color-lighten: oklch(80% 0 0); /* light grey */
    --card-color: oklch(20% 0 0); /* very dark grey */
    --card-color-transparent: oklch(20% 0 0 / 85%);
    --background-color: oklch(7% 0 0); /* black */

    --brand-font: "Raleway", "Noto Sans SC", sans-serif;
    --primary-font: "Noto Sans SC", sans-serif;
    --code-font: "JetBrains Mono", "Fira Code", monospace;

    --page-width-lg: 992px;
    --page-width-xl: 1264px;

    --banner-height: 55vh;
    --title-font: var(--brand-font);
    --title-color: oklch(100% 0 0 / 95%);
    --subtitle-font: var(--brand-font);
    --subtitle-color: oklch(100% 0 0 / 85%);

    --onload-animation-delay: 100ms;
    --onload-animation-interval: 100ms;
  }

  :root.dark {
    --primary-color: oklch(15% 0 0); /* dark grey */
    --primary-color-lighten: oklch(30% 0 0); /* lighter dark grey */
    --primary-color-hover: oklch(60% 0.21 29); /* vivid red for hover */
    --text-color: oklch(95% 0 0); /* white */
    --text-color-lighten: oklch(80% 0 0); /* light grey */
    --card-color: oklch(12% 0 0); /* very dark grey */
    --card-color-lighten: oklch(20% 0 0); /* dark grey */
    --card-color-transparent: oklch(12% 0 0 / 85%);
    --background-color: oklch(3% 0 0); /* black */
  }

  .swup-progress-bar {
    height: 5px;
    background-color: var(--primary-color);
  }
</style>
