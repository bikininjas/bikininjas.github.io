{
  "private": true,
  "scripts": {
    "build": "next build",
    "dev": "next dev",
    "start": "serve out -p 3000",
    "test": "jest --coverage",
    "test:unit": "jest tests/unit --coverage",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage --coverageReporters=lcov --coverageReporters=text --coverageReporters=cobertura --coverageReporters=json-summary",
    "test:e2e": "cypress run",
    "test:e2e:open": "cypress open",
    "test:e2e:headless": "bun run build && start-server-and-test 'serve out -p 3000' http://localhost:3000 'cypress run --headless --browser chromium --record'",
    "test:e2e:report": "bun run build && start-server-and-test 'serve out -p 3000' http://localhost:3000 'cypress run --headless --browser chromium --reporter mochawesome --record'",
    "test:playwright": "playwright test --project=chromium",
    "test:playwright:ui": "playwright test --ui",
    "test:all": "bun run test:coverage && bun run test:e2e:report",
    "test:deadcode": "jest tests/unit/deadcode.test.js",
    "test:sonar": "jest --coverage --testResultsProcessor=jest-sonar-reporter",
    "sonar:report": "node sonar-report.config.js",
    "sonar:prepare": "bun run test:coverage && bun run sonar:report",
    "sonar:local": "sonar-scanner",
    "coverage:summary": "cat ./coverage/coverage-summary.json | jq '.total'"
  },
  "dependencies": {
    "gray-matter": "^4.0.3",
    "next": "^15.2.4",
    "prop-types": "^15.8.1",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "remark": "^15.0.1",
    "remark-html": "^16.0.1"
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "@babel/preset-env": "^7.26.9",
    "@babel/preset-react": "^7.26.3",
    "@cypress/react": "^9.0.1",
    "@cypress/webpack-dev-server": "^4.0.2",
    "@playwright/test": "^1.51.1",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.2.0",
    "babel-jest": "^29.7.0",
    "cypress": "^14.2.1",
    "cypress-multi-reporters": "^1.6.4",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "jest-junit": "^16.0.0",
    "jest-sonar-reporter": "^2.0.0",
    "mocha-junit-reporter": "^2.2.1",
    "mochawesome": "^7.1.3",
    "mochawesome-merge": "^4.3.0",
    "mochawesome-report-generator": "^6.2.0",
    "serve": "^14.2.4",
    "start-server-and-test": "^2.0.11"
  }
}
