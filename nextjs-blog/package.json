    "remark-html": "^16.0.1"
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "@babel/preset-env": "^7.26.9",
    "@babel/preset-react": "^7.26.3",
    "@cypress/react": "^9.0.1",
    "@cypress/webpack-dev-server": "^4.0.2",
    "@playwright/test": "^1.51.1",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.2.0",
    "babel-jest": "^29.7.0",
    "cypress": "^14.2.1",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0"
  }
